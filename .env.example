# --- SIMRS Khanza database (MySQL / MariaDB) ---
KHANZA_DB_HOST=127.0.0.1
KHANZA_DB_PORT=3306
KHANZA_DB_NAME=sik

# SELECT-only user. Used by every read tool, Tanya Data and the scripts.
# Simha checks SHOW GRANTS at startup and refuses a user that can change data (e.g. root).
KHANZA_DB_READ_USER=harness_read
KHANZA_DB_READ_PASS=change-me

# Limited write user. Used ONLY by the server after a human approves a fix.
KHANZA_DB_WRITE_USER=harness_write
KHANZA_DB_WRITE_PASS=change-me

# Max run time of one read query (killed on the database server too).
KHANZA_QUERY_TIMEOUT=10 seconds

# --- Audit log (SQLite, separate from Khanza) ---
# Relative paths are resolved from the repository root.
AUDIT_DB_PATH=data/audit.sqlite

# --- AI provider ---
# "anthropic" = Claude API. "fake" = scripted test model (no key needed).
# Any other name = an OpenAI-compatible server (openai, ollama, lmstudio, vllm, openrouter, a gateway...).
# The name is also what the audit log records.
LLM_PROVIDER=anthropic
LLM_MODEL=claude-opus-5-5
# OpenAI-compatible servers: base URL, e.g. http://localhost:11434/v1 (Ollama).
# Leave empty for anthropic, openai, ollama and lmstudio (defaults are known).
LLM_BASE_URL=
LLM_API_KEY=
# Mask NIK, phone numbers and addresses before sending data to the AI provider.
# Only set to false for a model running on the hospital's own machines.
LLM_MASK_PII=true

# --- HTTP server ---
# 127.0.0.1 = this computer only. Use 0.0.0.0 to serve the hospital network (everyone must log in).
SERVER_HOST=127.0.0.1
SERVER_PORT=8787
# Set to true when the server is behind HTTPS (marks the login cookie Secure).
COOKIE_SECURE=false
# Optional: the built web UI (pnpm build), relative to the repo root.
# WEB_DIST_DIR=apps/web/dist

# --- Radiology images (Orthanc PACS, optional) ---
# Shows a patient's X-ray / CT images on the patient card, matched by No. RM = DICOM PatientID.
# Leave ORTHANC_URL empty to hide them. The browser never sees this address or login.
ORTHANC_URL=
ORTHANC_USER=
ORTHANC_PASS=

# Optional: where lihatSkema, cariAplikasiKhanza and the system prompt read the docs (relative to the repo root).
# SCHEMA_DOC_PATH=docs/schema.md
# KHANZA_NOTES_PATH=docs/khanza_notes.md
# APP_DOC_PATH=docs/khanza-app/index.json
