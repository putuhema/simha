# --- SIMRS Khanza database (MySQL / MariaDB) ---
KHANZA_DB_HOST=127.0.0.1
KHANZA_DB_PORT=3306
KHANZA_DB_NAME=sik

# SELECT-only user. Used by every read tool, Tanya Data and the scripts.
# The harness checks SHOW GRANTS at startup and refuses a user that can change data (e.g. root).
KHANZA_DB_READ_USER=harness_read
KHANZA_DB_READ_PASS=change-me

# Limited write user. Used ONLY by the server after a human approves a fix.
KHANZA_DB_WRITE_USER=harness_write
KHANZA_DB_WRITE_PASS=change-me

# Max run time of one read query (killed on the database server too).
KHANZA_QUERY_TIMEOUT=10 seconds

# --- Audit log (SQLite, separate from Khanza) ---
# Relative paths are resolved from the directory the server is started in.
AUDIT_DB_PATH=data/audit.sqlite

# --- AI provider ---
# anthropic | openai-compat | fake
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-5-5
# Only needed for openai-compat (OpenAI, Ollama, vLLM, LM Studio, OpenRouter, Gemini).
# Example for Ollama: http://localhost:11434/v1
LLM_BASE_URL=
LLM_API_KEY=
# Mask NIK, phone numbers and addresses before sending data to the AI provider.
LLM_MASK_PII=true
