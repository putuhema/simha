{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    "scripts": {
      "entry": [
        "*.ts"
      ]
    },
    "apps/desktop": {
      "entry": [
        "src/main.ts",
        "src/preload.ts",
        "src/terminal-preload.ts",
        "src/terminal/terminal.ts",
        "src/setup/setup.js",
        "scripts/*.mjs"
      ]
    }
  },
  "ignoreBinaries": [
    "mariadbd",
    "mariadb-install-db"
  ]
}
