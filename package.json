{
  "name": "@simrs/monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "inspect-schema": "pnpm --filter @simrs/scripts inspect-schema",
    "dump-test-schema": "pnpm --filter @simrs/scripts dump-test-schema",
    "tool": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning scripts/run-tool.ts",
    "start": "pnpm --filter @simrs/server start",
    "typecheck": "pnpm -r --parallel typecheck",
    "lint": "oxlint --report-unused-disable-directives",
    "knip": "knip",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@opentelemetry/api": "^1.10.0",
    "@types/node": "catalog:",
    "knip": "^6.42.1",
    "oxlint": "^1.89.0",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
