{
  "name": "@simha/desktop",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc -p .",
    "build": "pnpm --filter @simha/web build && node scripts/build.mjs",
    "dev": "node scripts/dev.mjs",
    "dist:win": "pnpm build && electron-builder --win nsis --x64",
    "dist:dir": "pnpm build && electron-builder --dir",
    "dist:mac": "pnpm build && electron-builder --mac dir"
  },
  "devDependencies": {
    "@simha/shared": "workspace:*",
    "@types/node": "catalog:",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "node-pty": "1.1.0",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "description": "Simha desktop app: the web UI in a window, with Buka di Khanza.",
  "author": "Simha",
  "main": "build/main.cjs"
}
